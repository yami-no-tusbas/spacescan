<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SpaceScan — Personal" Width="1280" Height="820" MinWidth="960" MinHeight="560" WindowStartupLocation="CenterScreen" Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" FontSize="12" UseLayoutRounding="True" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ground" Color="#0a0d13" />
    <SolidColorBrush x:Key="Pink" Color="#ff5c8a" />
    <SolidColorBrush x:Key="FieldBackground" Color="#10141d" />
    <SolidColorBrush x:Key="ButtonText" Color="#06101f" />
    <SolidColorBrush x:Key="MenuBackground" Color="#10141d" />
    <SolidColorBrush x:Key="Text" Color="#e8eef6" />
    <SolidColorBrush x:Key="Dim" Color="#8a97aa" />
    <SolidColorBrush x:Key="Dimmer" Color="#5d6879" />
    <SolidColorBrush x:Key="Accent" Color="#4c8dff" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2B4C8DFF" />
    <SolidColorBrush x:Key="Panel" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Panel2" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Edge" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="EdgeBright" Color="#2EFFFFFF" />
    <FontFamily x:Key="Mono">Consolas</FontFamily>
    <FontFamily x:Key="Display">Segoe UI</FontFamily>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Dimmer}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hdr" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Dimmer}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,4">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HdrRight" TargetType="Button" BasedOn="{StaticResource Hdr}">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBright}" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Panel2}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,0" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Dim}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Height="24" CornerRadius="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Panel2}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBright}" />
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SmallField" TargetType="TextBox" BasedOn="{StaticResource Field}">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="{DynamicResource Dimmer}" CornerRadius="0" Margin="2" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource Dim}" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource Dim}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="Height" Value="21" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="bg" Background="Transparent" />
              <Border x:Name="lead" Width="3" HorizontalAlignment="Left" Margin="0,4" CornerRadius="0" Background="{DynamicResource Accent}" Visibility="Collapsed" />
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Stretch" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Panel2}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="lead" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DriveItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
      <Setter Property="Height" Value="48" />
    </Style>
    <Style x:Key="Rows" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource Dim}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Panel2}" />
          <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#c42b1c" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MI" TargetType="MenuItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="0" Padding="12,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextBlock.Foreground="{TemplateBinding Foreground}" />
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="32,0,0,0" Foreground="{DynamicResource Dimmer}" FontFamily="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Sep" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="8,4" Background="{DynamicResource Edge}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ContextMenu x:Key="RowMenu" Foreground="{DynamicResource Text}" FontSize="13" HasDropShadow="False">
      <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource MenuBackground}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="0" Padding="5">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </ContextMenu.Template>
      <MenuItem Style="{StaticResource MI}" Tag="open" Header="Open" InputGestureText="Enter" />
      <MenuItem Style="{StaticResource MI}" Tag="explorer" Header="Show in Explorer" />
      <MenuItem Style="{StaticResource MI}" Tag="filelabs" Header="Open in File Labs" />
      <MenuItem Style="{StaticResource MI}" Tag="shelfmove" Header="Move this game to another drive (Shelf)" />
      <MenuItem Style="{StaticResource MI}" Tag="backuplabs" Header="Back up with Backup Labs" />
      <MenuItem Style="{StaticResource MI}" Tag="backuplabsjob" Header="Show in Backup Labs" />
      <MenuItem Style="{StaticResource MI}" Tag="copypath" Header="Copy path" InputGestureText="Ctrl+C" />
      <Separator Style="{StaticResource Sep}" />
      <MenuItem Style="{StaticResource MI}" Tag="copy" Header="Copy to…" />
      <MenuItem Style="{StaticResource MI}" Tag="move" Header="Move to…" />
      <Separator Style="{StaticResource Sep}" />
      <MenuItem Style="{StaticResource MI}" Tag="recycle" Header="Delete to Recycle Bin" InputGestureText="Del" />
      <MenuItem Style="{StaticResource MI}" Tag="delete" Header="Delete permanently" InputGestureText="Shift+Del" Foreground="{DynamicResource Pink}" />
      <Separator Style="{StaticResource Sep}" />
      <MenuItem Style="{StaticResource MI}" Tag="rescan" Header="Rescan" InputGestureText="F5" />
      <MenuItem Style="{StaticResource MI}" Tag="props" Header="Properties" />
    </ContextMenu>
    <DataTemplate x:Key="TreeRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource TreeCol0}" />
          <ColumnDefinition Width="{DynamicResource TreeCol1}" />
          <ColumnDefinition Width="{DynamicResource TreeCol2}" />
          <ColumnDefinition Width="{DynamicResource TreeCol3}" />
          <ColumnDefinition Width="{DynamicResource TreeCol4}" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="{Binding Indent}" Visibility="{DynamicResource TreeCol0Visibility}" ClipToBounds="True">
          <Border x:Name="chev" DockPanel.Dock="Left" Width="18" Background="Transparent" Cursor="Hand">
            <TextBlock Text="{Binding Chevron}" Foreground="{DynamicResource Dim}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Border>
          <Path DockPanel.Dock="Left" Data="{Binding IconData}" Fill="{Binding IconBrush}" Width="14" Height="12" Stretch="Uniform" Margin="3,0,9,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DisplayName}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Column="1" Width="150" Height="6" HorizontalAlignment="Left" Margin="12,0,0,0" Visibility="{DynamicResource TreeCol1Visibility}" ClipToBounds="True">
          <Border Background="{DynamicResource Edge}" CornerRadius="0" />
          <Border Background="{Binding BarBrush}" CornerRadius="0" Width="{Binding BarWidth}" HorizontalAlignment="Left" />
        </Grid>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding SizeText}" Visibility="{DynamicResource TreeCol2Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding PctText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource TreeCol3Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="4" Style="{StaticResource Num}" Text="{Binding FilesText}" Foreground="{DynamicResource Dim}" Margin="0,0,16,0" Visibility="{DynamicResource TreeCol4Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ExtRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource ExtCol0}" />
          <ColumnDefinition Width="{DynamicResource ExtCol1}" />
          <ColumnDefinition Width="{DynamicResource ExtCol2}" />
          <ColumnDefinition Width="{DynamicResource ExtCol3}" />
          <ColumnDefinition Width="{DynamicResource ExtCol4}" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Ext}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" Visibility="{DynamicResource ExtCol0Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}" Visibility="{DynamicResource ExtCol1Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding PctText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource ExtCol2Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding CountText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource ExtCol3Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="4" Style="{StaticResource Num}" Text="{Binding AvgText}" Foreground="{DynamicResource Dim}" Margin="0,0,16,0" Visibility="{DynamicResource ExtCol4Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="FoundRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource FoundCol0}" />
          <ColumnDefinition Width="{DynamicResource FoundCol1}" />
          <ColumnDefinition Width="{DynamicResource FoundCol2}" />
          <ColumnDefinition Width="{DynamicResource FoundCol3}" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{DynamicResource FoundCol0Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}" Visibility="{DynamicResource FoundCol1Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding ModifiedText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource FoundCol2Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="3" Text="{Binding Folder}" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,16,0" Visibility="{DynamicResource FoundCol3Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DupRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource DupCol0}" />
          <ColumnDefinition Width="{DynamicResource DupCol1}" />
          <ColumnDefinition Width="{DynamicResource DupCol2}" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" FontWeight="{Binding Weight}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{DynamicResource DupCol0Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}" Visibility="{DynamicResource DupCol1Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="2" Text="{Binding Info}" Foreground="{Binding InfoBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,16,0" Visibility="{DynamicResource DupCol2Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DriveRow">
      <Grid Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource DriveCol0}" />
          <ColumnDefinition Width="{DynamicResource DriveCol1}" />
          <ColumnDefinition Width="{DynamicResource DriveCol2}" />
          <ColumnDefinition Width="{DynamicResource DriveCol3}" />
          <ColumnDefinition Width="{DynamicResource DriveCol4}" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Visibility="{DynamicResource DriveCol0Visibility}" ClipToBounds="True">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Dimmer}" FontSize="11.5" />
        </StackPanel>
        <Grid Grid.Column="1" Width="180" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{DynamicResource DriveCol1Visibility}" ClipToBounds="True">
          <Border Background="{DynamicResource Edge}" CornerRadius="0" />
          <Border Background="{Binding BarBrush}" CornerRadius="0" Width="{Binding BarWidth}" HorizontalAlignment="Left" />
        </Grid>
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding UsedText}" Visibility="{DynamicResource DriveCol2Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding TotalText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource DriveCol3Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="4" Style="{StaticResource Num}" Text="{Binding FreeText}" Foreground="{DynamicResource Dim}" Margin="0,0,16,0" Visibility="{DynamicResource DriveCol4Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CmpRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource CmpCol0}" />
          <ColumnDefinition Width="{DynamicResource CmpCol1}" />
          <ColumnDefinition Width="{DynamicResource CmpCol2}" />
          <ColumnDefinition Width="{DynamicResource CmpCol3}" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{DynamicResource CmpCol0Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding BeforeText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource CmpCol1Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding AfterText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource CmpCol2Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="3" Style="{StaticResource Num}" Text="{Binding DeltaText}" Foreground="{Binding DeltaBrush}" FontWeight="SemiBold" Margin="0,0,16,0" Visibility="{DynamicResource CmpCol3Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TopRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource TopCol0}" />
          <ColumnDefinition Width="{DynamicResource TopCol1}" />
          <ColumnDefinition Width="{DynamicResource TopCol2}" />
          <ColumnDefinition Width="{DynamicResource TopCol3}" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{DynamicResource TopCol0Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SizeText}" Visibility="{DynamicResource TopCol1Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="2" Style="{StaticResource Num}" Text="{Binding PctText}" Foreground="{DynamicResource Dim}" Visibility="{DynamicResource TopCol2Visibility}" ClipToBounds="True" />
        <TextBlock Grid.Column="3" Text="{Binding Folder}" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="24,0,16,0" Visibility="{DynamicResource TopCol3Visibility}" ClipToBounds="True" />
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Popup x:Name="excludePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" VerticalOffset="8" HorizontalOffset="-180">
      <Border Background="{DynamicResource MenuBackground}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="0" Padding="16" Width="460">
        <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="SKIP THESE WHILE SCANNING — ONE RULE PER LINE" />
          <TextBox x:Name="excludeBox" Style="{StaticResource Field}" Height="150" Margin="0,10,0,0" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
          <TextBlock Foreground="{DynamicResource Dimmer}" FontSize="11.5" TextWrapping="Wrap" Margin="2,10,0,0" Text="node_modules — any folder or file with that name.   *.iso — every file with that extension.   C:\Windows\Temp — that path and everything under it. Rules apply to the next scan." />
          <Button x:Name="excludeApply" Style="{StaticResource Primary}" Content="Save" HorizontalAlignment="Right" Margin="0,14,0,0" />
          <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,0" />
          <TextBlock Style="{StaticResource Eyebrow}" Text="INTEGRATION" Margin="0,16,0,0" />
          <DockPanel Margin="0,10,0,0">
            <Button x:Name="shellBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Add" Margin="10,0,0,0" />
            <TextBlock Text="Right-click menu in Explorer" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <Button x:Name="fileLabsBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Get it" Margin="10,0,0,0" />
            <TextBlock x:Name="fileLabsText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="WORKS WITH" Margin="0,16,0,0" />
          <StackPanel x:Name="worksWith" />
          <Border Height="1" Background="{DynamicResource Edge}" Margin="0,16,0,0" />
          <TextBlock Style="{StaticResource Eyebrow}" Text="VERSION" Margin="0,16,0,0" />
          <DockPanel Margin="0,10,0,0">
            <Button x:Name="updateBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Upstream releases…" Margin="10,0,0,0" />
            <Button x:Name="whatsNewBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="What's new" Margin="10,0,0,0" />
            <TextBlock x:Name="updateText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" />
          </DockPanel>
        </StackPanel></ScrollViewer>
      </Border>
    </Popup>
    <Grid x:Name="shell" Margin="6,0,6,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Height="26" Margin="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,18,0">
          <TextBlock Text="SpaceScan" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,2" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="scanBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Scan" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button x:Name="browseBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Browse…" WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button x:Name="excludeBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Settings" WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button x:Name="drivesBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Drives  ▾" WindowChrome.IsHitTestVisibleInChrome="True" />
        <TextBox x:Name="pathBox" Style="{StaticResource Field}" Height="26" HorizontalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True" />
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,2,0,4">
        <Button x:Name="exportBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Export  ▾" />
        <Button x:Name="columnsBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Columns…" />
        <Button x:Name="themeBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Appearance ▾" />
        <Button x:Name="aboutBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="About" />
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="0" Padding="3" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="tabDrives" Style="{StaticResource Seg}" GroupName="view" Content="Drives" />
            <RadioButton x:Name="tabTree" Style="{StaticResource Seg}" GroupName="view" Content="Folders" IsChecked="True" />
            <RadioButton x:Name="tabExt" Style="{StaticResource Seg}" GroupName="view" Content="File types" />
            <RadioButton x:Name="tabTop" Style="{StaticResource Seg}" GroupName="view" Content="Largest files" />
            <RadioButton x:Name="tabSearch" Style="{StaticResource Seg}" GroupName="view" Content="Search" />
            <RadioButton x:Name="tabDup" Style="{StaticResource Seg}" GroupName="view" Content="Duplicates" />
            <RadioButton x:Name="tabCmp" Style="{StaticResource Seg}" GroupName="view" Content="Compare" />
          </StackPanel>
        </Border>
      </DockPanel>
      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="0">
        <Grid>
          <Grid x:Name="viewDrives" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <Button x:Name="scanAllBtn" Style="{StaticResource Primary}" Content="Scan all local drives" Margin="0" />
              <TextBlock Foreground="{DynamicResource Dimmer}" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12" Text="Double-click a drive to scan just that one." />
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource DriveCol0}" />
                <ColumnDefinition Width="{DynamicResource DriveCol1}" />
                <ColumnDefinition Width="{DynamicResource DriveCol2}" />
                <ColumnDefinition Width="{DynamicResource DriveCol3}" />
                <ColumnDefinition Width="{DynamicResource DriveCol4}" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Eyebrow}" Text="DRIVE" Visibility="{DynamicResource DriveCol0Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="USED" Visibility="{DynamicResource DriveCol1Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="USED" HorizontalAlignment="Right" Visibility="{DynamicResource DriveCol2Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="3" Style="{StaticResource Eyebrow}" Text="TOTAL" HorizontalAlignment="Right" Visibility="{DynamicResource DriveCol3Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="FREE" HorizontalAlignment="Right" Margin="0,0,16,0" Visibility="{DynamicResource DriveCol4Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="driveList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource DriveRow}" ItemContainerStyle="{StaticResource DriveItem}" />
          </Grid>
          <Grid x:Name="viewTree">
            <Grid.RowDefinitions>
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource TreeCol0}" />
                <ColumnDefinition Width="{DynamicResource TreeCol1}" />
                <ColumnDefinition Width="{DynamicResource TreeCol2}" />
                <ColumnDefinition Width="{DynamicResource TreeCol3}" />
                <ColumnDefinition Width="{DynamicResource TreeCol4}" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Eyebrow}" Text="NAME" Margin="18,0,0,0" Visibility="{DynamicResource TreeCol0Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="OF PARENT" Margin="12,0,0,0" Visibility="{DynamicResource TreeCol1Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="SIZE" HorizontalAlignment="Right" Visibility="{DynamicResource TreeCol2Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="3" Style="{StaticResource Eyebrow}" Text="%" HorizontalAlignment="Right" Visibility="{DynamicResource TreeCol3Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="FILES" HorizontalAlignment="Right" Margin="0,0,16,0" Visibility="{DynamicResource TreeCol4Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="treeList" Grid.Row="1" Style="{StaticResource Rows}" ItemTemplate="{StaticResource TreeRow}" SelectionMode="Extended" />
            <StackPanel x:Name="emptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
              <TextBlock Text="Nothing scanned yet" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Pick a drive or folder above and press Scan. Whole NTFS drives are read straight from the MFT." Foreground="{DynamicResource Dim}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Grid x:Name="viewExt" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="0" Padding="3" HorizontalAlignment="Left" Margin="14,12,0,10">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="byExt" Style="{StaticResource Seg}" GroupName="grouping" Content="Extensions" IsChecked="True" />
                <RadioButton x:Name="byCat" Style="{StaticResource Seg}" GroupName="grouping" Content="Categories" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource ExtCol0}" />
                <ColumnDefinition Width="{DynamicResource ExtCol1}" />
                <ColumnDefinition Width="{DynamicResource ExtCol2}" />
                <ColumnDefinition Width="{DynamicResource ExtCol3}" />
                <ColumnDefinition Width="{DynamicResource ExtCol4}" />
              </Grid.ColumnDefinitions>
              <Button x:Name="extHdrName" Style="{StaticResource Hdr}" Content="EXTENSION" Visibility="{DynamicResource ExtCol0Visibility}" ClipToBounds="True" />
              <Button x:Name="extHdrSize" Grid.Column="1" Style="{StaticResource HdrRight}" Content="SIZE" Visibility="{DynamicResource ExtCol1Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="%" HorizontalAlignment="Right" Visibility="{DynamicResource ExtCol2Visibility}" ClipToBounds="True" />
              <Button x:Name="extHdrFiles" Grid.Column="3" Style="{StaticResource HdrRight}" Content="FILES" Visibility="{DynamicResource ExtCol3Visibility}" ClipToBounds="True" />
              <Button x:Name="extHdrAvg" Grid.Column="4" Style="{StaticResource HdrRight}" Content="AVERAGE SIZE" Margin="0,0,16,0" Visibility="{DynamicResource ExtCol4Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="extList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource ExtRow}" />
          </Grid>
          <Grid x:Name="viewTop" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource TopCol0}" />
                <ColumnDefinition Width="{DynamicResource TopCol1}" />
                <ColumnDefinition Width="{DynamicResource TopCol2}" />
                <ColumnDefinition Width="{DynamicResource TopCol3}" />
              </Grid.ColumnDefinitions>
              <Button x:Name="topHdrName" Style="{StaticResource Hdr}" Content="NAME" Visibility="{DynamicResource TopCol0Visibility}" ClipToBounds="True" />
              <Button x:Name="topHdrSize" Grid.Column="1" Style="{StaticResource HdrRight}" Content="SIZE" Visibility="{DynamicResource TopCol1Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="%" HorizontalAlignment="Right" Visibility="{DynamicResource TopCol2Visibility}" ClipToBounds="True" />
              <Button x:Name="topHdrFolder" Grid.Column="3" Style="{StaticResource Hdr}" Content="FOLDER" Margin="24,0,0,0" Visibility="{DynamicResource TopCol3Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="topList" Grid.Row="1" Style="{StaticResource Rows}" ItemTemplate="{StaticResource TopRow}" SelectionMode="Extended" />
          </Grid>
          <Grid x:Name="viewSearch" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <TextBlock Style="{StaticResource Eyebrow}" Text="NAME CONTAINS" Margin="0,0,8,0" />
              <TextBox x:Name="findName" Style="{StaticResource SmallField}" Width="220" />
              <TextBlock Style="{StaticResource Eyebrow}" Text="MIN SIZE" Margin="18,0,8,0" />
              <TextBox x:Name="findSize" Style="{StaticResource SmallField}" Width="90" Text="100 MB" />
              <TextBlock Style="{StaticResource Eyebrow}" Text="UNTOUCHED FOR (DAYS)" Margin="18,0,8,0" />
              <TextBox x:Name="findAge" Style="{StaticResource SmallField}" Width="70" />
              <Button x:Name="findBtn" Style="{StaticResource Primary}" Content="Find" Margin="18,0,0,0" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource FoundCol0}" />
                <ColumnDefinition Width="{DynamicResource FoundCol1}" />
                <ColumnDefinition Width="{DynamicResource FoundCol2}" />
                <ColumnDefinition Width="{DynamicResource FoundCol3}" />
              </Grid.ColumnDefinitions>
              <Button x:Name="findHdrName" Style="{StaticResource Hdr}" Content="NAME" Visibility="{DynamicResource FoundCol0Visibility}" ClipToBounds="True" />
              <Button x:Name="findHdrSize" Grid.Column="1" Style="{StaticResource HdrRight}" Content="SIZE" Visibility="{DynamicResource FoundCol1Visibility}" ClipToBounds="True" />
              <Button x:Name="findHdrDate" Grid.Column="2" Style="{StaticResource HdrRight}" Content="MODIFIED" Visibility="{DynamicResource FoundCol2Visibility}" ClipToBounds="True" />
              <Button x:Name="findHdrFolder" Grid.Column="3" Style="{StaticResource Hdr}" Content="FOLDER" Margin="24,0,0,0" Visibility="{DynamicResource FoundCol3Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="foundList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource FoundRow}" SelectionMode="Extended" />
            <TextBlock x:Name="findHint" Grid.Row="2" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Search the scanned drive by name, size or age. On an NTFS drive this reads the MFT, so it takes seconds." />
          </Grid>
          <Grid x:Name="viewDup" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <TextBlock Style="{StaticResource Eyebrow}" Text="MIN SIZE" Margin="0,0,8,0" />
              <TextBox x:Name="dupSize" Style="{StaticResource SmallField}" Width="90" Text="10 MB" />
              <Button x:Name="dupBtn" Style="{StaticResource Primary}" Content="Find duplicates" Margin="18,0,0,0" />
              <TextBlock x:Name="dupSummary" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource DupCol0}" />
                <ColumnDefinition Width="{DynamicResource DupCol1}" />
                <ColumnDefinition Width="{DynamicResource DupCol2}" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Eyebrow}" Text="FILE" Visibility="{DynamicResource DupCol0Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="SIZE" HorizontalAlignment="Right" Visibility="{DynamicResource DupCol1Visibility}" ClipToBounds="True" />
              <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="FOLDER" Margin="24,0,0,0" Visibility="{DynamicResource DupCol2Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="dupList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource DupRow}" SelectionMode="Extended" />
            <TextBlock x:Name="dupHint" Grid.Row="2" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Finds files with identical contents (same size, then same hash) so you can delete the copies." />
          </Grid>
          <Grid x:Name="viewCmp" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="26" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Margin="14,12,12,10" LastChildFill="False">
              <Button x:Name="saveSnapBtn" Style="{StaticResource Ghost}" Content="Save snapshot…" Margin="0" />
              <Button x:Name="cmpPrevBtn" Style="{StaticResource Primary}" Content="Compare with previous scan" Margin="10,0,0,0" />
              <Button x:Name="cmpHistoryBtn" Style="{StaticResource Ghost}" Content="History  ▾" Margin="10,0,0,0" />
              <Button x:Name="cmpBtn" Style="{StaticResource Ghost}" Content="Open snapshot…" Margin="10,0,0,0" />
              <TextBlock x:Name="cmpSummary" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource CmpCol0}" />
                <ColumnDefinition Width="{DynamicResource CmpCol1}" />
                <ColumnDefinition Width="{DynamicResource CmpCol2}" />
                <ColumnDefinition Width="{DynamicResource CmpCol3}" />
              </Grid.ColumnDefinitions>
              <Button x:Name="cmpHdrPath" Style="{StaticResource Hdr}" Content="FOLDER" Visibility="{DynamicResource CmpCol0Visibility}" ClipToBounds="True" />
              <Button x:Name="cmpHdrBefore" Grid.Column="1" Style="{StaticResource HdrRight}" Content="BEFORE" Visibility="{DynamicResource CmpCol1Visibility}" ClipToBounds="True" />
              <Button x:Name="cmpHdrAfter" Grid.Column="2" Style="{StaticResource HdrRight}" Content="NOW" Visibility="{DynamicResource CmpCol2Visibility}" ClipToBounds="True" />
              <Button x:Name="cmpHdrDelta" Grid.Column="3" Style="{StaticResource HdrRight}" Content="CHANGE" Margin="0,0,16,0" Visibility="{DynamicResource CmpCol3Visibility}" ClipToBounds="True" />
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Edge}" />
            <ListBox x:Name="cmpList" Grid.Row="2" Style="{StaticResource Rows}" ItemTemplate="{StaticResource CmpRow}" />
            <TextBlock x:Name="cmpHint" Grid.Row="2" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="Save a snapshot of this scan, then compare a later scan against it to see what grew.&#10;A snapshot keeps folder sizes only, so it stays small." />
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="2,10,2,0">
        <Border Height="2" CornerRadius="0" Background="{DynamicResource Edge}" VerticalAlignment="Top" />
        <Border x:Name="progress" Height="2" CornerRadius="0" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0">
        </Border>
        <DockPanel Margin="2,8,2,0" LastChildFill="True">
          <Button x:Name="elevateBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Restart as administrator" Visibility="Collapsed" Height="26" Padding="14,0" FontSize="12" />
          <TextBlock x:Name="status" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>